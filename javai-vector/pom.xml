<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion> <!-- do_not_remove: published-with-gradle-metadata -->

  <parent>
    <groupId>io.github.dcaudell</groupId>
    <artifactId>javai</artifactId>
    <version>0.1.10-SNAPSHOT</version>
  </parent>

  <artifactId>javai-vector</artifactId>
  <packaging>jar</packaging>
  <name>JavAI Extensions -- Vector Core (Vector)</name>
  <description>Vector Core (part 1/2): embedding computation, dirty-state tracking, and pluggable embedding providers for JavAI Extensions.</description>

  <!--
    Pure vector/embedding functionality, nothing else: EmbeddingVector, VectorMath (CPU cosine-similarity
    backend), the JavAIEmbeddingProvider SPI + its two real HTTP-client implementations, and the
    dirty-tracking primitives (JavAIDirtyTracking/DirtyTrackingSupport/IdentityWeakReference); no
    reference anywhere in this module to JavAIList/Contextable, which is what lets it stay a true leaf
    dependency (only javai-annotations) rather than needing gson or anything collection-shaped. See
    doc/spec/vector-core.md and javai-model/pom.xml's own comment for why JavAIVectorizable/JavAIRuntime/
    the collection types live in javai-model instead of here, despite being conceptually "Vector Core" too.
  -->

  <dependencies>
    <dependency>
      <groupId>io.github.dcaudell</groupId>
      <artifactId>javai-annotations</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!--
          Publishes this module's test tree as a `tests`-classified jar, so dev.xtrafe.javai.vector.testsupport
          is usable from every downstream module's tests and from the standalone e2e-client-test project
          (which resolves JavAI from the local repository, so `mvn install` is enough — see its README).

          Added for OMI-187. Before it, FakeEmbeddingProvider existed as six byte-identical private copies,
          each documenting the decision not to share test code across module boundaries. That was a
          reasonable call for an inert 20-line fake and a bad one for a *measuring instrument*: OMI-187
          needs one instrumented provider (RecordingEmbeddingProvider) whose counts mean the same thing in
          javai-model, javai-tagging, javai-persistence and e2e alike. Six copies of a ruler is six rulers.

          This module is the right home because it owns the JavAIEmbeddingProvider SPI and every other
          module depends on it, directly or transitively — so the test-jar reaches all of them without
          inventing a new reactor module or perturbing the nine-module published set.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
